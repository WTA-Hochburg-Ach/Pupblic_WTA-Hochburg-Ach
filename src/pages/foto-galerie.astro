---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { galleryEntries, sortGalleryNewestFirst } from '../data/gallery';
import { formatDate, getNewsSlug } from '../lib/news';
import { getBaseUrl, withBasePath, withOptionalBasePath } from '../lib/site';

const baseUrl = getBaseUrl(import.meta.env.BASE_URL);
const newsEntries = await getCollection('news');
const newsBySlug = new Map(newsEntries.map((entry) => [getNewsSlug(entry), entry]));
const entries = sortGalleryNewestFirst(galleryEntries).map((entry) => {
  const linkedNews = entry.newsSlug ? newsBySlug.get(entry.newsSlug) : undefined;
  const date = linkedNews?.data.date ?? new Date(entry.date);

  return {
    ...entry,
    date,
    title: linkedNews?.data.title ?? entry.title,
    description: entry.description || linkedNews?.data.preview || '',
    eventHref: entry.newsSlug ? withBasePath(baseUrl, `news/${entry.newsSlug}`) : '',
    galleryHref: withOptionalBasePath(baseUrl, entry.galleryHref ?? ''),
    coverImage: withOptionalBasePath(baseUrl, entry.coverImage ?? ''),
  };
});
---

<BaseLayout title="Foto-Galerie">
  <section class="page-header gallery-intro">
    <h1 data-i18n="gallery.title">Foto-Galerie</h1>
    <p class="lead-text" data-i18n="gallery.lead">Rückblicke, Ausschreibungen und Bildserien sind hier flach und chronologisch gesammelt.</p>
  </section>

  <section class="content-block-spacious gallery-list-section">
    <h2 data-i18n="gallery.section_title">Galerien & Ausschreibungen</h2>

    <div class="gallery-list">
      {entries.map((entry) => (
        <article class="gallery-row">
          <a class="gallery-cover" href={entry.galleryHref || entry.eventHref} aria-label={`${entry.title} öffnen`}>
            {entry.coverImage ? (
              <img src={entry.coverImage} alt="" loading="lazy" />
            ) : (
              <div class="gallery-cover-fallback">
                <img src={withBasePath(baseUrl, 'wta-logo.svg')} alt="" class="fallback-logo" loading="lazy" />
              </div>
            )}
            <div class="gallery-cover-overlay"></div>
          </a>

          <div class="gallery-row-copy">
            <span class="event-date">{formatDate(entry.date)}</span>
            <h3>{entry.title}</h3>
            {entry.description && <p>{entry.description}</p>}
          </div>

          <div class="gallery-row-actions">
            {entry.eventHref && (
              <a class="read-more-btn" href={entry.eventHref} data-i18n="gallery.announcement">Ausschreibung</a>
            )}

            {entry.galleryHref ? (
              <a class="mini-action" href={entry.galleryHref} data-i18n="gallery.photo_gallery">Fotogalerie</a>
            ) : (
              <span class="gallery-pending" data-i18n="gallery.pending">Galerie folgt</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
.gallery-intro {
  padding-bottom: 0;
}

.gallery-list {
  display: grid;
  gap: 1.5rem;
}

.gallery-row {
  display: grid;
  grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
  gap: 1.5rem;
  align-items: center;
  padding: 1.5rem;
  border-radius: 24px;
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.gallery-row:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

.gallery-cover {
  position: relative;
  display: block;
  aspect-ratio: 4 / 3;
  border-radius: 16px;
  background: var(--color-bg-secondary);
  box-shadow: 0 4px 14px rgba(0,0,0,0.08);
  overflow: hidden;
  isolation: isolate;
}

.gallery-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.gallery-row:hover .gallery-cover img {
  transform: scale(1.05);
}

.gallery-cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-bg-secondary), var(--color-border-light));
}

.fallback-logo {
  width: 45%;
  height: auto;
  opacity: 0.15;
  object-fit: contain;
  transition: opacity 0.3s ease, transform 0.5s ease;
}

.gallery-row:hover .fallback-logo {
  opacity: 0.25;
  transform: scale(1.1);
}

.gallery-cover-overlay {
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  border-radius: 16px;
  pointer-events: none;
}

.gallery-row-copy h3 {
  margin: 0.65rem 0 0.45rem;
}

.gallery-row-copy p {
  margin: 0;
}

.gallery-row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  justify-content: flex-end;
  align-items: center;
}

.gallery-row-actions .read-more-btn {
  margin-top: 0;
}

.gallery-pending {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.9rem;
  padding: 0.55rem 0.95rem;
  border-radius: 999px;
  background: rgba(86, 112, 79, 0.08);
  color: var(--color-text-muted);
  font-size: 0.88rem;
  font-weight: 800;
}

@media (max-width: 900px) {
  .gallery-row {
    grid-template-columns: 1fr;
    padding: 1.25rem;
  }

  .gallery-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .gallery-row-actions {
    justify-content: stretch;
  }

  .gallery-row-actions > * {
    width: 100%;
  }
}
</style>
