---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDateRange, getNewsSlug, isEvent, isNews, sortByDateDescending } from '../lib/news';
import { getBaseUrl, withBasePath } from '../lib/site';

const baseUrl = getBaseUrl(import.meta.env.BASE_URL);
const entries = await getCollection('news');
const newestEntries = sortByDateDescending(entries);
const today = new Date();
today.setHours(23, 59, 59, 999);
const startOfToday = new Date(today);
startOfToday.setHours(0, 0, 0, 0);
const sevenDaysAgo = new Date(today);
sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);

const recentNews = newestEntries.filter((item) => {
  const itemDate = item.data.date.getTime();
  return isNews(item) && itemDate >= sevenDaysAgo.getTime() && itemDate <= today.getTime();
});

const olderNews = entries.filter((item) => {
  const itemDate = item.data.date.getTime();
  return isNews(item) && itemDate < sevenDaysAgo.getTime();
});

const pastEvents = entries.filter((item) => {
  const eventEnd = item.data.endDate ?? item.data.date;
  return isEvent(item) && eventEnd.getTime() < startOfToday.getTime();
});

const chronicleEntries = sortByDateDescending([...olderNews, ...pastEvents]).slice(0, 7);
const featuredNewsItem = recentNews[0];
const FeaturedNewsContent = featuredNewsItem ? (await render(featuredNewsItem)).Content : undefined;
---

<BaseLayout title="Aktuelles & Termine">
  <section class="page-header news-page-intro">
    <h1>Aktuelles & Vergangenes</h1>
    <p class="lead-text">Kurze Neuigkeiten und die  Chronik findest du hier in einer gemeinsamen Übersicht.</p>
    <p>Alle Einträge sind chronologisch nach Datum geordnet.  Termine führen zu ihrer Ausschreibung oder zu einer Detailseite, kurze News bleiben kompakt und schnell lesbar.</p>
  </section>

  <section class="content-block-spacious">
    <h2>Kurzmeldungen</h2>
    {recentNews.length > 0 ? (
      <div class="feature-grid featured-event-grid">
        {recentNews.map((item, index) => {
          const isFeatured = index === 0 && !!FeaturedNewsContent;

          return (
            <article class:list={['feature-card', 'featured-event-card', `tone-${item.data.color}`]}>
              <span class="event-date" data-date-start={item.data.date.toISOString()} data-date-end={item.data.endDate?.toISOString() ?? ''}>
                {formatDateRange(item.data.date, item.data.endDate)}
              </span>
              <h3>{item.data.title}</h3>
              {isFeatured ? (
                <div class="featured-entry-content">
                  <FeaturedNewsContent />
                </div>
              ) : (
                <>
                  <p>{item.data.preview}</p>
                  <a class="read-more-btn" href={withBasePath(baseUrl, `news/${getNewsSlug(item)}`)}>Weiterlesen</a>
                </>
              )}
            </article>
          );
        })}
      </div>
    ) : (
      <p class="archive-note">Aktuell gibt es keine Kurzmeldungen aus den letzten sieben Tagen. Ältere Beiträge stehen unten in der Chronik.</p>
    )}
  </section>

  <section class="content-block-spacious">
    <h2>Chronik</h2>
    {chronicleEntries.length > 0 ? (
      <div class="chronicle-list">
        {chronicleEntries.map((item) => (
          <article class:list={['chronicle-card', `tone-${item.data.color}`]}>
            <div>
              <div class="chronicle-meta">
                <span class="event-date" data-date-start={item.data.date.toISOString()} data-date-end={item.data.endDate?.toISOString() ?? ''}>
                  {formatDateRange(item.data.date, item.data.endDate)}
                </span>
                <span class:list={['entry-type', isEvent(item) ? 'entry-type-event' : 'entry-type-news']}>
                  {isEvent(item) ? 'Termin' : 'News'}
                </span>
              </div>

              <div class="chronicle-copy">
                <h3>{item.data.title}</h3>
                {item.data.location && <p class="event-location">{item.data.location}</p>}
                <p>{item.data.preview}</p>
              </div>
            </div>

            <div class="chronicle-actions">
              <a class="read-more-btn" href={withBasePath(baseUrl, `news/${getNewsSlug(item)}`)}>Weiterlesen</a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="archive-note">Es gibt noch keine vergangenen Beiträge in der Chronik.</p>
    )}
  </section>
</BaseLayout>

<style>
.news-page-intro {
  padding-bottom: 0;
}

.featured-event-grid {
  align-items: stretch;
}

.featured-event-card,
.chronicle-card {
  border-left: 4px solid transparent;
}

.featured-entry-content {
  display: grid;
  gap: 0.75rem;
  margin-top: 0.4rem;
}

.featured-entry-content :global(p) {
  margin: 0;
}

.chronicle-list {
  display: grid;
  gap: 1rem;
}

.archive-note {
  text-align: center;
}

.chronicle-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 1.25rem;
  align-items: center;
  padding: 1.5rem;
  border-radius: 24px;
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
}

.chronicle-actions .read-more-btn {
  min-width: 11rem;
}

.chronicle-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
  align-items: center;
  margin-bottom: 0.85rem;
}

.chronicle-copy h3 {
  margin-bottom: 0.6rem;
}

.chronicle-copy p {
  margin: 0;
}

.event-location {
  font-size: 0.96rem;
  font-weight: 700;
  color: var(--color-text-muted);
}

.entry-type {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.entry-type-event {
  background: rgba(86, 112, 79, 0.12);
  color: var(--color-primary-dark);
}

.entry-type-news {
  background: rgba(188, 162, 112, 0.16);
  color: var(--color-accent-dark);
}

.tone-moss {
  border-left-color: #56704f;
}

.tone-sage {
  border-left-color: #90a388;
}

.tone-gold {
  border-left-color: #bca270;
}

@media (max-width: 820px) {
  .chronicle-card {
    grid-template-columns: 1fr;
  }

  .chronicle-actions .read-more-btn {
    width: 100%;
  }
}
</style>
