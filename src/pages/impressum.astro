---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  boardMembers,
  contactData,
  partnerLinks,
  siteLegal,
  siteMeta,
  venue,
} from '../data/site';

const chair = boardMembers[0];
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venue.mapQuery)}`;
---

<BaseLayout title="Impressum & Datenschutz">
  <div class="legal-container">
    <h1>Impressum & Datenschutz</h1>

    <section class="legal-section">
      <h2>Verein</h2>
      <p>
        <strong>{siteMeta.legalName}</strong><br />
        {chair.name}<br />
        {chair.street}<br />
        {chair.cityLine}<br />
        {chair.country}
      </p>

      <p>
        <strong>Telefon:</strong> <a href={contactData.phone.href}>{contactData.phone.compact}</a><br />
        <strong>WhatsApp:</strong> <a href={contactData.whatsapp.href} target="_blank" rel="noopener noreferrer">{contactData.whatsapp.phoneLabel}</a><br />
        <strong>E-Mail:</strong> <a href={`mailto:${contactData.email}`}>{contactData.email}</a><br />
        <strong>ZVR-Zahl:</strong> {siteLegal.registrationNumber}
      </p>
    </section>

    <section class="legal-section">
      <h2>Verantwortliche Personen</h2>
      {boardMembers.map((member) => (
        <p>
          <strong>{member.role}:</strong> {member.name}<br />
          {member.street}<br />
          {member.cityLine}<br />
          {member.country}
        </p>
      ))}
    </section>

    <section class="legal-section">
      <h2>Trainingsort & Kontakt</h2>
      <p>
        <strong>Trainingsort:</strong> {venue.name}<br />
        {venue.street}<br />
        {venue.postalCode} {venue.city}<br />
        {venue.country}
      </p>

      <p><strong>Google Maps:</strong> <a href={mapHref} target="_blank" rel="noopener noreferrer">Trainingsort oeffnen</a></p>
    </section>

    <section class="legal-section">
      <h2>Haftungshinweis</h2>
      <p>{siteLegal.liabilityNotice}</p>
    </section>

    <section class="legal-section">
      <h2>Datenschutz</h2>
      <p>{siteLegal.privacyNotice}</p>
    </section>

    <section class="legal-section">
      <h2>Urheberrecht</h2>
      <p>{siteLegal.copyrightText}</p>
    </section>

    <section class="legal-section">
      <h2>Externe Links</h2>
      <ul>
        {partnerLinks.map((item) => (
          <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
