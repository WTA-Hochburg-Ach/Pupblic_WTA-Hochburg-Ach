---
import { navItems, siteLinks } from '../data/site';
import { getBaseUrl, isCurrentSitePath, normalizeSitePath, withBasePath } from '../lib/site';

const baseUrl = getBaseUrl(import.meta.env.BASE_URL);
const currentPath = normalizeSitePath(Astro.url.pathname, baseUrl);
const logoLight = withBasePath(baseUrl, 'images/logo/logo_light.svg');
const logoDark = withBasePath(baseUrl, 'images/logo/logo_dark.svg');

const fallbackLabels = {
  'nav.about': 'Ueber uns',
  'nav.training': 'Training',
  'nav.events': 'Termine',
  'nav.news': 'Aktuelles',
  'nav.gallery': 'Galerie',
  'nav.links': 'Links',
  'nav.contact': 'Kontakt',
};
---

<div class="utility-bar">
  <div class="utility-inner">
    <button class="theme-btn" id="theme-toggle" type="button" aria-label="Farbschema wechseln">
      <span class="theme-track" aria-hidden="true">
        <span class="theme-thumb">
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.2M12 19.3v2.2M4.8 4.8l1.6 1.6M17.6 17.6l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.8 19.2l1.6-1.6M17.6 6.4l1.6-1.6" />
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 15.5A8.5 8.5 0 1 1 12.5 4a6.5 6.5 0 0 0 7.5 11.5Z" />
            <path d="M16.5 3.5v2M21 8h-2M18.9 5.1l-1.4 1.4" />
          </svg>
        </span>
      </span>
      <span class="theme-copy">
        <span class="theme-kicker" data-i18n="common.theme">Theme</span>
        <span class="theme-label" data-theme-label>Hell</span>
      </span>
    </button>

    <div class="lang-selector">
      <button class="lang-btn" type="button" aria-label="Sprache aendern" aria-expanded="false">
        <svg class="lang-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3a14 14 0 0 1 0 18" />
          <path d="M12 3a14 14 0 0 0 0 18" />
        </svg>
        <span class="lang-copy">
          <strong data-current-lang>DE</strong>
          <span data-i18n="common.language">Sprache</span>
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </button>

      <div class="lang-dropdown">
        <a href="#" class="lang-option" data-lang="de">
          <span>Deutsch</span>
          <span>DE</span>
        </a>
        <a href="#" class="lang-option" data-lang="en">
          <span>English</span>
          <span>EN</span>
        </a>
        <a href="#" class="lang-option" data-lang="fr">
          <span>Francais</span>
          <span>FR</span>
        </a>
      </div>
    </div>
  </div>
</div>

<nav class="nav">
  <div class="nav-inner">
    <a href={withBasePath(baseUrl, siteLinks.home)} class="logo">
      <span class="logo-mark" aria-hidden="true">
        <img src={logoLight} alt="" class="theme-logo theme-logo-light" />
        <img src={logoDark} alt="" class="theme-logo theme-logo-dark" />
      </span>
      <span class="logo-copy">
        <span class="logo-kicker">Wanomichi Takemusu</span>
        <span class="logo-name">Aikido</span>
        <span class="logo-location">Hochburg-Ach</span>
      </span>
    </a>

    <button class="menu-toggle" type="button" aria-label="Menue oeffnen" aria-expanded="false">
      <span class="hamburger"></span>
    </button>

    <ul class="nav-links">
      {navItems.map((item) => {
        const isActive = isCurrentSitePath(currentPath, item.href, baseUrl);
        const hasSummary = item.labelKey !== 'nav.contact';

        return (
          <li class:list={['nav-item', hasSummary && 'nav-item-with-summary']}>
            <a
              href={withBasePath(baseUrl, item.href)}
              class:list={['nav-link', isActive && 'nav-link-active']}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="nav-link-label" data-i18n={item.labelKey}>
                {fallbackLabels[item.labelKey as keyof typeof fallbackLabels]}
              </span>
              {hasSummary && (
                <span class="nav-link-hint" data-i18n={item.summaryKey}>
                  {item.summary}
                </span>
              )}
            </a>
            {hasSummary && (
              <div class="nav-flyout">
                <p data-i18n={item.summaryKey}>{item.summary}</p>
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</nav>

<script>
  const html = document.documentElement;
  const appWindow = window as Window &
    typeof globalThis & {
      i18n?: {
        t: (key: string, fallback?: string) => string;
      };
    };
  const themeToggle = document.getElementById('theme-toggle');
  const themeLabel = document.querySelector('[data-theme-label]');
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  const langBtn = document.querySelector('.lang-btn');
  const langDropdown = document.querySelector('.lang-dropdown');
  const nav = document.querySelector('.nav');

  function updateNavState() {
    const isScrolled = window.scrollY > 28;
    html.classList.toggle('nav-scrolled', isScrolled);
  }

  function closeMenu() {
    navLinks?.classList.remove('open');
    menuToggle?.classList.remove('open');
    menuToggle?.setAttribute('aria-expanded', 'false');
  }

  function closeLanguageMenu() {
    langDropdown?.classList.remove('show');
    langBtn?.setAttribute('aria-expanded', 'false');
  }

  function updateThemeUi(theme: string) {
    themeToggle?.setAttribute('data-theme', theme);

    if (themeLabel instanceof HTMLElement) {
      const fallback = theme === 'dark' ? 'Dunkel' : 'Hell';
      themeLabel.textContent = appWindow.i18n?.t(`common.theme_${theme}`, fallback) ?? fallback;
    }
  }

  function setTheme(theme: string) {
    html.dataset.theme = theme;
    localStorage.setItem('theme', theme);
    updateThemeUi(theme);
  }

  updateThemeUi(html.dataset.theme || 'light');
  updateNavState();

  themeToggle?.addEventListener('click', () => {
    const nextTheme = html.dataset.theme === 'dark' ? 'light' : 'dark';
    setTheme(nextTheme);
  });

  document.addEventListener('languageChanged', () => {
    updateThemeUi(html.dataset.theme || 'light');
  });

  menuToggle?.addEventListener('click', () => {
    const isOpen = navLinks?.classList.toggle('open');
    menuToggle.classList.toggle('open', Boolean(isOpen));
    menuToggle.setAttribute('aria-expanded', String(isOpen));
  });

  document.querySelectorAll('.nav-links a').forEach((link) => {
    link.addEventListener('click', () => {
      closeMenu();
    });
  });

  langBtn?.addEventListener('click', (event) => {
    event.stopPropagation();
    langDropdown?.classList.toggle('show');
    langBtn?.setAttribute('aria-expanded', String(langDropdown?.classList.contains('show')));
  });

  document.addEventListener('click', (event) => {
    closeLanguageMenu();

    if (!(event.target instanceof Node)) {
      return;
    }

    if (!nav?.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeLanguageMenu();
      closeMenu();
    }
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1100) {
      closeMenu();
    }

    updateNavState();
  });

  window.addEventListener('scroll', updateNavState, { passive: true });
</script>
