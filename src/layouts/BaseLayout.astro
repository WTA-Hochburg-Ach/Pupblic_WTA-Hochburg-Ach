---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ScrollTop from '../components/ScrollTop.astro';
import { siteMeta } from '../data/site';
import { getBaseUrl, withBasePath } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  content?: string;
}

const {
  title,
  description = siteMeta.description,
  content,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const baseUrl = getBaseUrl(import.meta.env.BASE_URL);
const siteTitle = siteMeta.browserName;
const documentTitle = title === siteMeta.name ? siteTitle : `${title} | ${siteTitle}`;
---

<html lang="de" data-page-title={title} data-site-title={siteTitle}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <meta name="keywords" content="Aikido, Dojo, Kampfkunst, Braunau, Training, Hochburg-Ach" />
  <meta name="author" content={siteMeta.name} />
  <meta name="application-name" content={siteTitle} />
  <meta name="apple-mobile-web-app-title" content={siteTitle} />

  <meta name="google-site-verification" content="sAZll9CS62QGBBDyIgnM6qUmnSwoYhdY7sD94qMJqGA" />
  
  <meta property="og:type" content="website" />
  {canonicalURL && <meta property="og:url" content={canonicalURL} />}
  <meta property="og:title" content={documentTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="de_DE" />

  <link rel="icon" type="image/svg+xml" href={withBasePath(baseUrl, 'images/logo/logo_light.png')} />

  <title>{documentTitle}</title>
  {canonicalURL && <link rel="canonical" href={canonicalURL} />}

  <script is:inline define:vars={{ baseUrl }}>
    window.__SITE_BASE__ = baseUrl;

    try {
      const storedTheme = localStorage.getItem('theme');
      const preferredTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = storedTheme || preferredTheme;
    } catch {
      document.documentElement.dataset.theme = 'light';
    }
  </script>

  <link rel="stylesheet" href={withBasePath(baseUrl, 'styles/colors.css')} />
  <link rel="stylesheet" href={withBasePath(baseUrl, 'styles/base.css')} />
  <link rel="stylesheet" href={withBasePath(baseUrl, 'styles/components.css')} />
  <link rel="stylesheet" href={withBasePath(baseUrl, 'styles/navigation.css')} />
  <link rel="stylesheet" href={withBasePath(baseUrl, 'styles/legal.css')} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,500..700,50&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Manrope:wght@400;500;600;700;800&family=Noto+Serif+JP:wght@500;600;700&display=swap" rel="stylesheet" />

  <script is:inline src={withBasePath(baseUrl, 'scripts/i18n.js')}></script>
</head>

<body>
  <div class="site-wrapper">
    <Navigation />

    <main class="content">
      {content ? <div set:html={content} /> : <slot />}
    </main>

    <Footer />
  </div>

  <ScrollTop />
</body>
</html>
